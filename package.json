{
  "name": "ducky",
  "version": "0.1.0",
  "description": "Floating voice-activated desktop duck agent",
  "main": "dist/main/index.js",
  "author": "Ducky",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.js",
    "start": "npm run build && electron .",
    "dev": "npm run start",
    "test": "vitest run",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.ducky.desktop",
    "productName": "Ducky",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "package.json"],
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true }
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.6.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@azure/msal-node": "^7.2.2"
  }
}
